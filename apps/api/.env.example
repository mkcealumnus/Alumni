# ==============================================================================
# ALUMNUX API ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# MySQL Database Configuration (cPanel / Local MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=alumnux
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_HASH_COST=12
COOKIE_SECRET=replace_with_a_long_cookie_signing_secret
