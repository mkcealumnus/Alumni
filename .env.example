# ==============================================================================
# ALUMNUX ENVIRONMENT CONFIGURATION (TEMPLATE)
# Note: Copy this file to .env.local for local development. Never commit secrets.
# ==============================================================================

# Supabase Public API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-Only, Private)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Private Document Storage Bucket for ID & Degree Evidence
SUPABASE_STORAGE_BUCKET_PRIVATE=alumnux-private-credentials

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Credentials (Configured in Supabase Dashboard)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Designated Senior Alumni Admin Emails (Must match the 3 designated trustees)
SENIOR_ADMIN_EMAIL_1=trustee1.infra@alumnux.org
SENIOR_ADMIN_EMAIL_2=trustee2.product@alumnux.org
SENIOR_ADMIN_EMAIL_3=trustee3.governance@alumnux.org
