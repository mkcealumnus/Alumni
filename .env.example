# ==============================================================================
# ALUMNUX MONOREPO ENVIRONMENT TEMPLATE
# Copy to .env or workspace-specific .env.local. NEVER commit secrets.
# ==============================================================================

# Web Application
VITE_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# API Service
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Mobile Application (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000

# MySQL database configuration (same names consumed by the API)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=alumnux
DATABASE_USER=alumnux_user
DATABASE_PASSWORD=your_secure_password_here

# Governance Trustees
SENIOR_ADMIN_EMAIL_1=trustee1.infra@alumnux.org
SENIOR_ADMIN_EMAIL_2=trustee2.product@alumnux.org
SENIOR_ADMIN_EMAIL_3=trustee3.governance@alumnux.org
