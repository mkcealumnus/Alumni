# ==============================================================================
# ALUMNUX ENVIRONMENT CONFIGURATION (VITE + REACT 19 TEMPLATE)
# Note: Copy this file to .env.local for local development. Never commit secrets.
# ==============================================================================

# Supabase Public API URL (Vite client-accessible)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (Vite client-accessible, public anon key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Base URL
VITE_SITE_URL=http://localhost:3000

# Private Document Storage Bucket for ID & Degree Evidence (Configured in Supabase Storage)
SUPABASE_STORAGE_BUCKET_PRIVATE=alumnux-private-credentials

# Google OAuth Credentials (Configured in Supabase Dashboard -> Authentication -> Providers)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Designated Senior Alumni Admin Emails (Must match the 3 designated trustees)
SENIOR_ADMIN_EMAIL_1=trustee1.infra@alumnux.org
SENIOR_ADMIN_EMAIL_2=trustee2.product@alumnux.org
SENIOR_ADMIN_EMAIL_3=trustee3.governance@alumnux.org
