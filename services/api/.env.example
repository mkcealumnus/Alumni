# Alumnux API Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Future MySQL Configuration (Do not use production credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alumnux_db
DB_USER=alumnux_user
DB_PASSWORD=your_secure_password_here

# JWT Secret for future authentication
JWT_SECRET=super_secret_development_key_change_in_production
